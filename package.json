{
  "name": "ai-bees",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm run install:browsers",
    "install:browsers": "node scripts/install-playwright.mjs chromium",
    "dev": "node --import tsx server/index.ts",
    "dev:client": "vite",
    "dev:server": "node --import tsx server/index.ts",
    "build": "tsc -b && vite build",
    "check": "tsc -b && oxlint src server",
    "lint": "oxlint src server",
    "test": "vitest run",
    "preview": "NODE_ENV=production node --import tsx server/index.ts"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.32",
    "express": "5.2.1",
    "playwright": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.81.0",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
